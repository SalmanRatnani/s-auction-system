{
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "files.associations": { "*.sql": "sql" },
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "files.exclude": {
    "**/.gitkeep": true
  },
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ]
}